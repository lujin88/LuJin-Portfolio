<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f7f6f2">
<meta name="description" content="Diandian, a little AI dolphin. Turn the knob. Pick a mood. Play.">
<title>Diandian — Turn. Talk. Play.</title>
<link rel="icon" href="data:image/png;base64,">
<style>
@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("data:font/woff2;base64,") format("woff2")}
@font-face{font-family:"Poppins";font-style:normal;font-weight:400;font-display:swap;src:url("data:font/woff2;base64,") format("woff2")}
@font-face{font-family:"Remix";font-style:normal;font-weight:400;font-display:swap;src:url("data:font/woff2;base64,") format("woff2")}
:root{--paper:#f7f6f2;--ink:#131313;--blue:#2f6cf3;--muted:#5d5b57;--ring:#6acdf6;--ease:cubic-bezier(.22,.68,0,1.08)}
*{box-sizing:border-box}html{scrollbar-width:none;scroll-behavior:smooth;scroll-padding-top:110px}html::-webkit-scrollbar{display:none}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}button,a,input{-webkit-tap-highlight-color:transparent}button,input{font:inherit}button{color:inherit;cursor:pointer}button{border:0;background:none}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--blue);outline-offset:6px}button:disabled{cursor:default}::selection{background:#b9d6ff}.shell{width:calc(100% - 200px);max-width:1240px;margin-inline:auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.ri{font-family:Remix!important;font-style:normal;font-weight:normal;line-height:1;display:inline-block;-webkit-font-smoothing:antialiased}.ri-arrow-down-s-line:before{content:"\ea4e"}.ri-voiceprint-line:before{content:"\f29a"}.ri-refresh-line:before{content:"\f064"}.ri-shuffle-line:before{content:"\f124"}.ri-close-line:before{content:"\eb99"}.ri-check-line:before{content:"\eb7b"}.ri-arrow-right-line:before{content:"\ea6c"}.ri-phone-line:before{content:"\efec"}.ri-volume-up-line:before{content:"\f2a2"}.ri-volume-mute-line:before{content:"\f29e"}.ri-menu-line:before{content:"\ef3e"}.ri-play-line:before{content:"\f00b"}.ri-pause-line:before{content:"\efd8"}
.site-header{height:98px;position:fixed;z-index:30;inset:0 0 auto;background:linear-gradient(var(--paper) 15%,#f7f6f2ed 70%,#f7f6f200);isolation:isolate}.site-header:before{content:"";position:absolute;z-index:-1;inset:0;backdrop-filter:blur(16px);mask-image:linear-gradient(#000 76%,transparent)}.nav{padding-right:12px;height:96px;display:flex;align-items:center;gap:48px;font-size:17px;font-family:Arial,Helvetica,sans-serif;color:#535353}.brand{width:44px;height:44px;display:flex;align-items:center;justify-content:center;margin-left:6px;flex-shrink:0}.brand img{width:32px;height:32px;border-radius:7px}.nav-links{display:flex;align-items:center;gap:58px;margin-left:auto}.nav-actions{display:flex;align-items:center;gap:34px;margin-left:97px}.nav-button{font-family:inherit;font-size:inherit;display:flex;align-items:center;gap:7px;padding:12px 0;color:inherit}.nav-button .ri{font-size:13px}.nav-link{padding-block:12px}.nav-link:hover,.nav-button:hover{color:#111}.contact-link{font-family:Poppins,Arial,sans-serif;font-size:16px;color:var(--ink);border:1px solid #c7c5c0;min-width:173px;padding:12px 28px;border-radius:100px;text-align:center;transition:background .2s,border-color .2s}.contact-link:hover{background:#fff;border-color:#8c8a85}.dropdown{position:relative}.dropdown-menu{position:absolute;top:50px;left:-18px;min-width:190px;padding:8px;background:#fffefb;border:1px solid #e7e4de;border-radius:14px;box-shadow:0 14px 40px #0000000e}.dropdown-menu[hidden]{display:none}.dropdown-menu a,.dropdown-menu button{display:block;padding:12px;width:100%;font-size:14px;text-align:left;border-radius:7px;white-space:nowrap}.dropdown-menu a:hover,.dropdown-menu button:hover{background:#f0efea}.mobile-menu{display:none;font-size:24px}
.hero{height:780px;position:relative}.hero-layout{display:grid;grid-template-columns:1fr 1fr;gap:0;padding-top:139px}.hero-copy h1{font-family:Inter,Arial,sans-serif;font-size:140px;letter-spacing:-9.5px;line-height:.89;font-weight:800;margin:0 0 29px -5px}.hero-copy h1 span{display:block}.hero-copy h1 .turn{background:linear-gradient(#494947 -10%,#111 80%);background-clip:text;-webkit-background-clip:text;color:transparent}.hero-copy h1 .talk{color:var(--blue)}.hero-copy p{color:#5a5854;font-size:20px;letter-spacing:-.65px;line-height:1.42;margin:0;max-width:330px}.hero-copy strong{font-weight:600;color:#161616}.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:28px}.tags span{font-size:13px;line-height:26px;padding:0 9px;background:#eceae5;color:#8c8983;border-radius:4px}
.hero-playground{position:relative;height:540px;margin-top:56px}.hero-knob-wrap{position:absolute;left:110px;top:0;width:400px;height:400px}.mode-label{position:absolute;top:-23px;width:100%;text-align:center;color:#63605b;font-size:14px;letter-spacing:-.35px}
.knob{width:100%;height:100%;position:relative;border-radius:50%;isolation:isolate;touch-action:none;user-select:none;cursor:grab;filter:drop-shadow(-15px 22px 17px #0000002b);--angle:36deg;--arc:120deg;--ring:#6acdf6;transition:filter .25s}.knob:active{cursor:grabbing}.knob:focus-visible{outline:none}.knob:focus-visible .bezel{outline:2px solid var(--blue);outline-offset:-6px}.knob.is-pressed{filter:drop-shadow(-7px 12px 10px #00000026)}.metal-rim{position:absolute;inset:0;border-radius:50%;background:repeating-conic-gradient(from 0deg,#eef1f185 0deg 1.05deg,#9fa8ab25 1.7deg 5deg),conic-gradient(from 8deg,#aeb7ba,#e2e7e9 19%,#bac2c4 30%,#9da8ab 43%,#e9ecee 54%,#b2babd 69%,#f3f5f6 82%,#bac2c6);transform:rotate(var(--angle));box-shadow:inset 0 0 3px #ffffffb0;transition:transform .65s var(--ease)}.metal-shine{position:absolute;inset:0;border-radius:50%;background:linear-gradient(130deg,transparent 0%,#ffffff7d 24%,transparent 40%,#ffffff0a 55%,#0000000e 73%,#ffffff4d 86%);box-shadow:inset 0 0 16px #f5f7f79e;pointer-events:none}.indicator-track{position:absolute;inset:0;transform:rotate(var(--angle));transition:transform .65s var(--ease);pointer-events:none}.indicator{position:absolute;width:8px;height:8px;background:var(--ring);border-radius:50%;left:calc(50% - 4px);top:6.8%;box-shadow:0 0 7px color-mix(in srgb,var(--ring),transparent 60%)}.bezel{position:absolute;inset:9%;border-radius:50%;background:#2b3438;border:3px solid #12191d;box-shadow:0 0 0 2px #444e51,inset 0 0 0 3px #65707550;transition:transform .2s}.knob.is-pressed .bezel{transform:scale(.975)}.led{position:absolute;inset:3px;border-radius:50%;background:conic-gradient(var(--ring) 0deg var(--arc),#2d373b var(--arc) 360deg);transition:background .4s}.display{position:absolute;inset:10px;border-radius:50%;background:#fff;overflow:hidden;transform:translateZ(0)}.display video{width:100%;height:100%;object-fit:cover;transform:scale(1.07);display:block;filter:brightness(1.085) saturate(1.035)}.voice-badge{position:absolute;bottom:13%;left:50%;transform:translateX(-50%);display:flex;align-items:center;justify-content:center;gap:4px;border-radius:30px;width:49px;height:30px;background:#fffefb;box-shadow:0 2px 6px #00000008;opacity:0;transition:opacity .2s}.voice-badge.visible{opacity:1}.voice-badge i{display:block;background:#205d61;width:4px;border-radius:4px;height:10px;animation:voice .65s ease-in-out infinite alternate}.voice-badge i:nth-child(1){height:5px;animation-delay:-.3s}.voice-badge i:nth-child(2){height:17px;animation-delay:-.1s}.voice-badge i:nth-child(3){height:21px;animation-delay:-.5s}.voice-badge i:nth-child(4){height:13px;animation-delay:-.2s}@keyframes voice{to{transform:scaleY(.4)}}
.side-controls{position:absolute;left:5px;top:62px;display:flex;flex-direction:column;align-items:center;width:48px;gap:13px;color:#aaa69e}.control-label{font-size:11px;font-weight:400;line-height:1.5;color:#99958e}.mood-button{padding:0;border:1px solid #d6d4cd;border-radius:50%;height:40px;width:40px;background:#f8f7f4;overflow:hidden}.mood-button img{width:100%;height:100%;object-fit:cover}.mood-button:hover{border-color:#444}.icon-control{display:grid;place-items:center;width:40px;height:40px;color:#b2aea6;font-size:18px;transition:color .2s,transform .2s}.icon-control:hover,.icon-control[aria-pressed="true"]{color:#555;transform:scale(1.08)}.color-controls{position:absolute;left:556px;top:78px;width:72px;display:flex;flex-direction:column;align-items:center;gap:2px}.color-controls .control-label{font-size:12px;font-weight:500;line-height:18px;color:#77736c;white-space:nowrap;margin-bottom:8px}.swatch{width:32px;height:32px;border-radius:50%;position:relative;display:grid;place-items:center;padding:0;transition:transform .2s}.swatch:before{content:"";position:absolute;inset:6px;border-radius:50%;background:var(--swatch);opacity:.65;transition:opacity .2s}.swatch:hover{transform:scale(1.1)}.swatch:hover:before,.swatch[aria-pressed="true"]:before{opacity:1}.swatch[aria-pressed="true"]:after{content:"";position:absolute;inset:1px;border:1.5px solid var(--swatch);border-radius:50%}.swatch .ri{position:relative;z-index:1;font-size:13px;color:#173e48;opacity:0}.swatch[aria-pressed="true"] .ri{opacity:1}.scrubber{position:absolute;left:160px;top:432px;width:300px;height:24px;display:flex;align-items:center}.scrubber input{width:100%;height:8px;appearance:none;-webkit-appearance:none;border-radius:20px;background:linear-gradient(#dddad3,#e9e6e0);cursor:ew-resize;margin:0}.scrubber input::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;border:1px solid #e8e5df;height:20px;width:20px;border-radius:50%;background:white;box-shadow:0 2px 4px #0002}.scrubber input::-moz-range-thumb{border:1px solid #e8e5df;height:18px;width:18px;border-radius:50%;background:white;box-shadow:0 2px 4px #0002}.mood-menu{position:absolute;z-index:10;top:112px;left:57px;width:145px;border:1px solid #e4e0d7;background:#fffefb;border-radius:12px;padding:6px;box-shadow:0 12px 40px #00000015}.mood-menu[hidden]{display:none}.mood-menu button{display:block;width:100%;text-align:left;padding:9px 11px;font-size:13px;border-radius:7px}.mood-menu button:hover{background:#f2f0ea}
.gallery{height:790px;margin:0 8px;position:relative;overflow:hidden;border-radius:0 0 12px 12px;background:#f7f6f2;isolation:isolate;scroll-margin-top:96px}.gallery:before{content:"";position:absolute;z-index:3;left:-12px;right:-12px;top:-1px;height:12px;background:radial-gradient(circle at 12px 0,var(--paper) 12px,transparent 12.5px) 0 0/24px 14px repeat-x;pointer-events:none}.gallery-board{position:absolute;left:calc(50% + 26px);top:calc(50% + 231px);width:1810px;height:1170px;display:grid;grid-template-columns:repeat(5,1fr);gap:8px;transform:translate(-50%,-50%) rotate(-8deg);transform-origin:center center}.gallery-column{position:relative;align-self:start;display:flex;flex-direction:column;gap:8px;min-width:0;transition:transform .85s cubic-bezier(.22,1,.36,1)}.gallery-continuation{position:absolute;left:0;width:100%;display:flex;flex-direction:column;gap:8px;pointer-events:none}.gallery-before{bottom:calc(100% + 8px)}.gallery-after{top:calc(100% + 8px)}.gallery-column:nth-child(1){transform:translateY(-75px)}.gallery-column:nth-child(2){transform:translateY(-100px)}.gallery-column:nth-child(3){transform:translateY(-45px)}.gallery-column:nth-child(4){transform:translateY(-20px)}.gallery-column:nth-child(5){transform:translateY(55px)}.tile{position:relative;flex-shrink:0;width:100%;height:380px;padding:18px;text-align:left;overflow:hidden;background:var(--tile);color:#fff;transition:filter .25s}.tile:hover{filter:brightness(1.035)}.tile:focus-visible{outline:4px solid #fff;outline-offset:-7px}.tile-label{position:absolute;left:16px;top:16px;font-size:14px;font-weight:500;z-index:2}.tile-circle{position:absolute;width:255px;height:255px;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:50%;background:#fff;box-shadow:0 0 0 10px #ffffff30,0 19px 24px #00000018;overflow:hidden;}.tile-circle video{width:100%;height:100%;object-fit:cover;filter:brightness(1.085) saturate(1.035)}.tile.word-tile{height:350px;display:flex;align-items:flex-end;padding:18px}.word-tile strong{font-family:Inter,Arial,sans-serif;font-size:48px;font-weight:800;letter-spacing:-2px;line-height:1.1}.tile.phone-tile{height:660px;display:flex;align-items:center;justify-content:center}.phone{position:relative;width:238px;height:510px;flex-shrink:0;border:8px solid #f9f8f1;border-radius:36px;background:#fbfaf5;box-shadow:15px 25px 25px #00000020;color:#444;display:flex;flex-direction:column;align-items:center;padding-top:30px;transform:rotate(1deg)}.phone:before{content:"";position:absolute;width:60px;height:20px;border-radius:20px;top:9px;background:#171917}.phone-time{font-size:11px;position:absolute;left:18px;top:12px}.phone-name{font-size:18px;font-weight:600;margin:12px 0 4px}.phone-status{font-size:10px;color:#8c8d86}.phone video{width:100%;height:265px;object-fit:cover;margin-top:8px}.phone-wave{height:28px;color:#757c78;font-size:24px}.phone-hangup{width:53px;height:53px;display:grid;place-items:center;background:#ff6567;border-radius:50%;margin-top:16px;color:white;box-shadow:0 0 0 7px #ff656721,0 5px 12px #ff656749}.phone-hangup .ri{font-size:26px;transform:rotate(135deg)}
.page-bottom{height:46px}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,10px);background:#202522;color:white;border-radius:100px;padding:12px 20px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:60}.toast.show{opacity:1;transform:translate(-50%,0)}
dialog{border:1px solid #e1ddd4;border-radius:22px;background:var(--paper);color:var(--ink);padding:44px;max-width:480px;width:calc(100% - 40px);box-shadow:0 30px 100px #0003}dialog::backdrop{background:#242c3045;backdrop-filter:blur(7px)}.dialog-close{position:absolute;right:16px;top:16px;font-size:24px;width:36px;height:36px}dialog h2{font-size:40px;letter-spacing:-2px;margin:6px 0 14px}dialog p{font-size:17px;color:#615d55;line-height:1.6}dialog .email-link{font-size:19px;border-bottom:1px solid #aaa49a;display:inline-block;margin-top:10px}.dialog-eyebrow{font:12px ui-monospace,monospace;color:#8e887d}
@media(min-width:1600px){.hero{height:830px}.hero-layout{padding-top:170px}.hero-playground{margin-top:50px}.gallery{height:860px}}
@media(max-width:1350px){.shell{width:calc(100% - 112px)}.nav{gap:28px}.nav-links{gap:34px}.nav-actions{margin-left:40px;gap:25px}.hero{height:740px}.hero-layout{padding-top:145px}.hero-copy h1{font-size:125px;letter-spacing:-8px}.hero-copy p{font-size:18px;max-width:310px}.tags{gap:4px}.tags span{font-size:11px;padding-inline:7px}.hero-playground{margin-top:45px;transform:scale(.87);transform-origin:50% 0}.hero-knob-wrap{left:calc(50% - 200px)}.side-controls{left:-42px}.color-controls{left:calc(50% + 236px)}.scrubber{left:calc(50% - 150px)}}
@media(max-width:1000px){.shell{width:calc(100% - 72px)}.nav-links{gap:25px}.nav-actions{margin-left:10px;gap:20px}.contact-link{min-width:130px;padding-inline:20px}.nav{font-size:15px}.hero-copy h1{font-size:112px}.hero{height:710px}.hero-playground{transform:scale(.72);margin-top:45px}.side-controls{left:-96px}.hero-copy p{max-width:285px;font-size:17px}.tags{max-width:330px}.gallery-board{width:1550px}.tile-circle{width:225px;height:225px}.gallery{height:730px}.word-tile strong{font-size:43px}}
@media(min-width:761px) and (max-width:1000px){.color-controls{left:min(calc(50% + 236px),calc(119.4% - 24px))}}
@media(max-width:760px){.shell{width:calc(100% - 44px)}.site-header{height:82px}.nav{padding-right:0;height:78px;gap:0;justify-content:space-between}.brand{margin-left:0;width:32px}.nav-links{display:none}.nav-actions{gap:18px;margin-left:auto}.nav-actions .language-picker{display:none}.contact-link{min-width:116px;font-size:13px;padding:9px 16px}.mobile-menu{display:block;margin-left:18px}.nav-links.mobile-open{display:flex;position:absolute;top:76px;left:16px;right:16px;padding:16px 22px;border-radius:14px;background:#fffefa;box-shadow:0 15px 45px #0001;gap:25px;flex-wrap:wrap}.dropdown-menu{z-index:5}.hero{height:auto;min-height:1010px}.hero-layout{padding-top:116px;grid-template-columns:1fr}.hero-copy h1{font-size:clamp(96px,22vw,136px);line-height:.88;letter-spacing:-7px;margin-left:-3px;margin-bottom:26px}.hero-copy p{font-size:18px;max-width:330px;letter-spacing:-.5px}.tags{margin-top:23px;max-width:none;gap:5px}.tags span{font-size:9.5px;padding-inline:6px;line-height:23px}.hero-playground{height:430px;width:100%;margin-top:55px;transform:none}.hero-knob-wrap{width:280px;height:280px;left:calc(50% - 140px)}.mode-label{top:-22px;font-size:12px}.side-controls{left:-11px;top:22px;width:34px;gap:7px}.control-label{font-size:10px}.mood-button{width:30px;height:30px}.icon-control{width:30px;height:33px;font-size:16px}.color-controls{left:50%;top:348px;width:max-content;transform:translateX(-50%);display:grid;grid-template-columns:repeat(6,32px);gap:4px 8px}.color-controls .control-label{grid-column:1/-1;text-align:center;margin-bottom:2px;font-size:12px}.swatch{width:32px;height:32px}.scrubber{top:313px;width:240px;left:calc(50% - 120px)}.mood-menu{top:70px;left:24px}.gallery{height:650px;margin-inline:4px;border-radius:0 0 9px 9px}.gallery-board{width:1250px;height:1150px;transform:translate(-50%,-50%) rotate(-8deg)}.tile{height:320px}.tile-circle{width:180px;height:180px;box-shadow:0 0 0 8px #ffffff30,0 14px 20px #00000018}.tile.word-tile{height:270px}.word-tile strong{font-size:32px;letter-spacing:-1px}.tile-label{font-size:12px}.phone{transform:scale(.85)}.page-bottom{height:15px}}
@media(max-width:370px){.hero-knob-wrap{width:250px;height:250px;left:calc(50% - 125px)}.side-controls{left:-15px}.color-controls{top:325px}.scrubber{top:290px}.hero{min-height:970px}.hero-copy h1{font-size:90px}.tags{gap:3px}.tags span{font-size:9px}}
.parent-section{padding-top:110px;padding-bottom:26px;scroll-margin-top:20px}.parent-intro{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:end;margin-bottom:46px}.parent-eyebrow{font:11px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:1.2px;color:#78756e;margin:0 0 22px}.parent-intro h2{font-family:Inter,Arial,sans-serif;font-size:64px;font-weight:780;line-height:1.04;letter-spacing:-3.8px;margin:0}.parent-intro h2 span{color:var(--blue)}.parent-story{max-width:390px;padding-bottom:4px}.parent-story p{font-size:18px;line-height:1.55;letter-spacing:-.3px;color:#605d57;margin:0 0 22px}.prototype-link{display:inline-flex;align-items:center;gap:18px;font-size:16px;padding-bottom:6px;border-bottom:1px solid #aaa59d}.prototype-link .ri{font-size:20px;transition:transform .25s}.prototype-link:hover .ri{transform:translate(2px,-2px)}.creation-stage{display:grid;grid-template-columns:minmax(0,1fr) 258px;gap:52px;align-items:center;background:#ebe9e3;border-radius:22px;padding:30px 36px 30px 40px;position:relative}.studio-window{min-width:0;background:#fffefd;border:1px solid #d7d5d0;border-radius:13px;box-shadow:0 16px 32px #3e352813;overflow:hidden}.studio-chrome{height:43px;border-bottom:1px solid #e9e7e2;display:flex;align-items:center;padding:0 17px;gap:14px;font-size:12px;color:#68655f}.window-dots{display:flex;gap:5px}.window-dots i{width:6px;height:6px;border-radius:50%;background:#d7d4ce}.studio-chrome-note{margin-left:auto;font:8px ui-monospace,monospace;letter-spacing:1px;color:#9c978e}.studio-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:22px 24px 18px}.studio-toolbar strong{font-family:Inter,Arial,sans-serif;font-size:21px;font-weight:650;letter-spacing:-.8px}.studio-toolbar>span{font-size:11px;color:#918b81}.studio-body{display:grid;grid-template-columns:1.08fr 1fr;gap:20px;padding:0 24px 24px}.studio-preview{min-width:0;background:#f7f5f1;border-radius:8px;display:flex;flex-direction:column;justify-content:center;overflow:hidden;position:relative}.studio-preview>video{display:block;width:100%;height:260px;object-fit:contain;background:#fff;filter:brightness(1.06)}.studio-preview-caption{display:flex;align-items:center;gap:7px;font-size:11px;padding:15px 12px;white-space:nowrap}.studio-live-dot{height:5px;width:5px;border-radius:50%;background:#4ca88a}.studio-loop{margin-left:auto;color:#999388;font-size:9px}.studio-moods{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.studio-mood{min-width:0;padding:5px 6px 6px;border:1px solid #eae7e1;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:border-color .2s,background .2s;position:relative}.studio-mood>img{height:58px;width:66px;object-fit:cover;border-radius:4px}.studio-mood>span{font-size:10px;color:#6d675d}.studio-mood:hover{background:#f4f2ee}.studio-mood[aria-pressed=true]{border-color:var(--blue);background:#f0f5ff}.studio-mood[aria-pressed=true]:after{content:'\eb7b';font-family:Remix;position:absolute;right:5px;top:5px;width:13px;height:13px;display:grid;place-items:center;font-size:10px;color:#fff;background:var(--blue);border-radius:50%}.studio-footer{border-top:1px solid #eeebe5;display:flex;align-items:center;justify-content:space-between;padding:13px 22px;gap:12px}.studio-download{font-size:11px;color:#79736b;display:inline-flex;align-items:center;gap:7px}.studio-download:hover{color:#111}.studio-download .ri{font-size:15px}.studio-open{display:inline-flex;align-items:center;gap:16px;border-radius:6px;background:#2f6cf3;color:white;padding:10px 13px;font-size:11px}.studio-open:hover{background:#2459ce}.hardware-destination{position:relative;display:flex;align-items:center;flex-direction:column;text-align:center;padding:16px 0 4px}.destination-label{font:10px ui-monospace,monospace;letter-spacing:1.4px;color:#8a8478;margin-bottom:30px}.destination-arrow{position:absolute;left:-35px;top:145px;color:#a9a397;font-size:28px}.hardware-preview{width:216px;height:216px;border-radius:50%;padding:19px;background:repeating-conic-gradient(from 5deg,#ffffff55 0deg 1deg,transparent 1.8deg 6deg),conic-gradient(#c6cecf,#e4e8e9,#aeb8bb,#dce0e1,#c6cecf);box-shadow:-8px 22px 25px #323c4226,inset 0 1px 3px #fff;transform:rotate(8deg)}.hardware-bezel{width:100%;height:100%;border-radius:50%;border:6px solid #273338;padding:4px;background:#8acdf2;box-shadow:0 0 0 2px #121b1f;overflow:hidden}.hardware-bezel video{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;filter:brightness(1.07);background:white;transform:rotate(-8deg)}.destination-title{font-family:Inter,Arial,sans-serif;font-size:23px;font-weight:650;letter-spacing:-.9px;line-height:1.2;margin:33px 0 10px}.destination-note{color:#8e877b;font-size:11px}.creation-steps{list-style:none;margin:32px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}.creation-steps li{display:flex;gap:17px;border-top:1px solid #dedbd4;padding-top:22px}.step-number{font:11px ui-monospace,monospace;color:#938c80;margin-top:5px}.creation-steps h3{font-family:Inter,Arial,sans-serif;font-size:20px;letter-spacing:-.7px;font-weight:650;margin:0 0 8px}.creation-steps p{font-size:14px;line-height:1.45;color:#797268;margin:0;max-width:260px}.prototype-note{font-size:11px;line-height:1.5;color:#989186;margin:35px 0 0}.ri-arrow-right-up-line:before{content:'\ea70'}.ri-download-2-line:before{content:'\ec54'}
@media(max-width:1150px){.parent-intro{gap:40px}.parent-intro h2{font-size:54px;letter-spacing:-3px}.parent-story p{font-size:16px}.creation-stage{grid-template-columns:minmax(0,1fr) 205px;gap:28px;padding:30px 24px}.studio-toolbar{padding:19px 16px 15px}.studio-toolbar>span{display:none}.studio-body{gap:12px;padding:0 16px 18px}.studio-preview-caption{padding:13px 8px;font-size:10px}.studio-loop{display:none}.studio-mood>img{height:49px;width:55px}.hardware-preview{width:180px;height:180px;padding:16px}.destination-title{font-size:21px}.destination-arrow{left:-20px;top:125px;font-size:23px}.creation-steps{gap:22px}.creation-steps li{gap:12px}}
@media(max-width:760px){.parent-section{padding-top:66px;padding-bottom:24px}.parent-intro{grid-template-columns:1fr;gap:22px;margin-bottom:28px}.parent-eyebrow{font-size:9px;margin-bottom:16px}.parent-intro h2{font-size:46px;letter-spacing:-2.6px}.parent-story{max-width:440px}.parent-story p{font-size:16px;margin-bottom:16px}.prototype-link{font-size:14px}.creation-stage{grid-template-columns:1fr;gap:30px;padding:17px 13px 28px;border-radius:14px;margin-inline:-8px}.studio-chrome{padding:0 12px;height:36px;font-size:10px;gap:8px}.studio-chrome-note{font-size:7px}.window-dots{gap:3px}.window-dots i{width:4px;height:4px}.studio-toolbar{padding:16px 12px 13px}.studio-toolbar strong{font-size:18px}.studio-body{gap:10px;padding:0 12px 15px;grid-template-columns:1fr 1fr}.studio-moods{gap:5px}.studio-mood{padding:3px 2px 5px;gap:2px}.studio-mood>img{width:42px;height:39px}.studio-mood>span{font-size:8px}.studio-preview>video{height:190px}.studio-preview-caption{padding:10px 7px;font-size:9px;gap:5px}.studio-footer{padding:11px 12px;gap:7px}.studio-download{font-size:9px;gap:4px}.studio-open{font-size:10px;gap:8px;padding:9px 11px}.hardware-destination{display:grid;grid-template-columns:150px 1fr;column-gap:20px;align-items:start;text-align:left;padding:0 12px}.destination-label{grid-column:2;grid-row:1;margin:12px 0 12px;font-size:8px}.hardware-preview{grid-column:1;grid-row:1/4;width:150px;height:150px;padding:14px}.hardware-bezel{border-width:4px;padding:3px}.destination-title{grid-column:2;grid-row:2;font-size:19px;letter-spacing:-.7px;margin:0 0 12px}.destination-note{grid-column:2;grid-row:3;font-size:9px}.destination-arrow{display:none}.creation-steps{grid-template-columns:1fr;gap:0;margin-top:22px}.creation-steps li{padding:18px 0;gap:19px}.creation-steps h3{font-size:19px;margin-bottom:5px}.creation-steps p{font-size:13px;max-width:none}.prototype-note{margin-top:12px;font-size:10px}}
@media(max-width:370px){.parent-intro h2{font-size:40px}.hardware-destination{grid-template-columns:126px 1fr;gap:15px;padding:0 5px}.hardware-preview{width:126px;height:126px;padding:12px}.destination-title{font-size:17px}.studio-chrome-note{display:none}}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header class="site-header"><nav class="nav shell" aria-label="Main navigation">
 <a class="brand" href="#top" aria-label="Lu — back to top"><img src="data:image/png;base64," alt="Lu" width="32" height="32"></a>
 <div class="nav-links" id="nav-links">
  <div class="dropdown"><button class="nav-button" aria-expanded="false" aria-controls="projects-menu"><span data-i18n="projects">Projects</span><i class="ri ri-arrow-down-s-line" aria-hidden="true"></i></button><div class="dropdown-menu" id="projects-menu" hidden><a href="#top">Diandian</a><a href="#parent-mode" data-i18n="parentmode">Parent mode</a></div></div>
  <div class="dropdown"><button class="nav-button" aria-expanded="false" aria-controls="play-menu"><span data-i18n="playground">Playground</span><i class="ri ri-arrow-down-s-line" aria-hidden="true"></i></button><div class="dropdown-menu" id="play-menu" hidden><a href="#gallery" data-i18n="allmoods">A little of every mood</a><a href="#parent-mode" data-i18n="animationstudio">Animation studio</a></div></div>
  <button class="nav-link" data-dialog="about-dialog" data-i18n="about">About</button>
 </div>
 <div class="nav-actions"><div class="dropdown language-picker"><button class="nav-button" aria-expanded="false" aria-controls="language-menu"><span id="language-name">English</span><i class="ri ri-arrow-down-s-line" aria-hidden="true"></i></button><div class="dropdown-menu" id="language-menu" hidden><button data-language="en" lang="en">English</button><button data-language="zh" lang="zh">中文</button></div></div><button class="contact-link" data-dialog="contact-dialog" data-i18n="contact">Contact Me</button></div>
 <button class="mobile-menu" aria-label="Open navigation" aria-controls="nav-links" aria-expanded="false"><i class="ri ri-menu-line" aria-hidden="true"></i></button>
</nav></header>
<main id="top">
<section class="hero" aria-labelledby="hero-title"><div class="hero-layout shell">
 <div class="hero-copy"><h1 id="hero-title"><span class="turn">Turn.</span><span class="talk">Talk.</span><span>Play.</span></h1><p data-i18n="intro"><strong>Diandian</strong> is an AI dolphin my five-year-old calls from a phone — or wakes with a turn of the knob on the desk. Gemini will not speak to anyone under 18, so the call goes through Volcano Engine instead. Pronunciation does not come across cleanly on the hardware, so that path needed a workaround of its own.</p><div class="tags" aria-label="Project disciplines"><span>HARDWARE</span><span>VOICE AI</span><span>MOTION</span><span>KIDS</span></div></div>
 <div class="hero-playground" aria-label="Diandian playground">

  <div class="side-controls"><span class="control-label">mood</span><button class="mood-button" aria-label="Choose Diandian’s mood" title="Choose a mood" aria-expanded="false" aria-controls="mood-menu"><img data-poster="listen" alt=""></button><span class="control-label">voice</span><button class="icon-control" id="voice-toggle" aria-label="Enable demo voice" title="Enable demo voice" aria-pressed="false"><i class="ri ri-voiceprint-line" aria-hidden="true"></i></button><button class="icon-control" id="reset" aria-label="Reset playground" title="Reset"><i class="ri ri-refresh-line" aria-hidden="true"></i></button><button class="icon-control" id="shuffle" aria-label="Shuffle mood" title="Surprise me"><i class="ri ri-shuffle-line" aria-hidden="true"></i></button></div>
  <div class="mood-menu" id="mood-menu" hidden><button data-mood="listen">Listening</button><button data-mood="happy">Happy</button><button data-mood="wave">Waving</button><button data-mood="curious">Curious</button><button data-mood="comfort">Comforting</button><button data-mood="sleep">Sleepy</button></div>
  <div class="hero-knob-wrap"><div class="mode-label" id="hero-status" aria-live="polite">Listening</div><div class="knob" id="hero-knob" role="slider" tabindex="0" aria-label="Diandian mode. Drag to turn, or use arrow keys. Press Enter to play." aria-valuemin="0" aria-valuemax="5" aria-valuenow="1" aria-valuetext="Listen"><div class="metal-rim"></div><div class="metal-shine"></div><div class="indicator-track"><i class="indicator"></i></div><div class="bezel"><div class="led"></div><div class="display"><video data-video="listen" muted playsinline preload="auto" aria-label="Diandian listening" data-loop-gap="2000"></video><span class="voice-badge" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div></div></div></div>
  <div class="color-controls" role="group" aria-labelledby="ring-color-label"><span class="control-label" id="ring-color-label" data-i18n="ringcolor">Ring color</span><button class="swatch" style="--swatch:#50d4d1" data-color="#50d4d1" aria-label="Turquoise ring" title="Turquoise" aria-pressed="false"><i class="ri ri-check-line" aria-hidden="true"></i></button><button class="swatch" style="--swatch:#6acdf6" data-color="#6acdf6" aria-label="Sky blue ring" title="Sky blue" aria-pressed="true"><i class="ri ri-check-line" aria-hidden="true"></i></button><button class="swatch" style="--swatch:#b696ff" data-color="#b696ff" aria-label="Lilac ring" title="Lilac" aria-pressed="false"><i class="ri ri-check-line" aria-hidden="true"></i></button><button class="swatch" style="--swatch:#85dfaa" data-color="#85dfaa" aria-label="Mint ring" title="Mint" aria-pressed="false"><i class="ri ri-check-line" aria-hidden="true"></i></button><button class="swatch" style="--swatch:#ffb65e" data-color="#ffb65e" aria-label="Peach ring" title="Peach" aria-pressed="false"><i class="ri ri-check-line" aria-hidden="true"></i></button><button class="swatch" style="--swatch:#ff8199" data-color="#ff8199" aria-label="Pink ring" title="Pink" aria-pressed="false"><i class="ri ri-check-line" aria-hidden="true"></i></button></div>
  <label class="scrubber"><span class="sr-only">Turn the knob to choose a mode</span><input id="mode-range" type="range" min="0" max="5" step="1" value="1" aria-valuetext="Listen"></label>
 </div>
</div></section>
<section class="gallery" id="gallery" aria-label="A little of every mood"><div class="gallery-board">
 <div class="gallery-column"><button class="tile" style="--tile:#131313" data-gallery-mood="curious"><span class="tile-label">Curious</span><span class="tile-circle"><video data-video="curious" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile phone-tile" style="--tile:#ff783c" data-gallery-mood="talk" aria-label="A call with Diandian"><span class="phone"><span class="phone-time">9:41</span><span class="phone-name">Diandian</span><span class="phone-status">your little friend</span><video data-video="talk" muted playsinline preload="none" data-loop-gap="2000"></video><span class="phone-wave ri ri-voiceprint-line" aria-hidden="true"></span><span class="phone-hangup"><i class="ri ri-phone-line" aria-hidden="true"></i></span></span></button><button class="tile" style="--tile:#b99aff" data-gallery-mood="comfort"><span class="tile-label">Always here</span><span class="tile-circle"><video data-video="comfort" muted playsinline preload="none" data-loop-gap="2000"></video></span></button></div>
 <div class="gallery-column"><button class="tile word-tile" style="--tile:#ff783c" data-gallery-mood="happy"><strong>Hello, you.</strong></button><button class="tile" style="--tile:#8d6bea" data-gallery-mood="happy"><span class="tile-label">Happy</span><span class="tile-circle"><video data-video="happy" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile" style="--tile:#131313" data-gallery-mood="nod"><span class="tile-label">Nodding</span><span class="tile-circle"><video data-video="nod" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile" style="--tile:#68c9f4" data-gallery-mood="wave"><span class="tile-label">French time</span><span class="tile-circle"><video data-video="wave" muted playsinline preload="none" data-loop-gap="2000"></video></span></button></div>
 <div class="gallery-column"><button class="tile" style="--tile:#68c9f4" data-gallery-mood="wave"><span class="tile-label">Waving</span><span class="tile-circle"><video data-video="wave" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile word-tile" style="--tile:#f9d836" data-gallery-mood="sleep"><strong>Goodnight.</strong></button><button class="tile" style="--tile:#306cf0" data-gallery-mood="listen"><span class="tile-label">Listening</span><span class="tile-circle"><video data-video="listen" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile word-tile" style="--tile:#ff783c" data-gallery-mood="talk"><strong>Let's talk.</strong></button></div>
 <div class="gallery-column"><button class="tile" style="--tile:#306cf0" data-gallery-mood="wait"><span class="tile-label">A little daydream</span><span class="tile-circle"><video data-video="wait" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile" style="--tile:#7edca1" data-gallery-mood="excited"><span class="tile-label">Excited</span><span class="tile-circle"><video data-video="excited" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile word-tile" style="--tile:#ff748b" data-gallery-mood="wave"><strong>Bonjour!</strong></button><button class="tile" style="--tile:#ff748b" data-gallery-mood="sleep"><span class="tile-label">Sleepy</span><span class="tile-circle"><video data-video="sleep" muted playsinline preload="none" data-loop-gap="2000"></video></span></button></div>
 <div class="gallery-column"><button class="tile" style="--tile:#ffb55d" data-gallery-mood="comfort"><span class="tile-label">Comforting</span><span class="tile-circle"><video data-video="comfort" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile" style="--tile:#306cf0" data-gallery-mood="eat"><span class="tile-label">Eating</span><span class="tile-circle"><video data-video="eat" muted playsinline preload="none" data-loop-gap="2000"></video></span></button><button class="tile word-tile" style="--tile:#b99aff" data-gallery-mood="happy"><strong>A little joy.</strong></button></div>
</div></section>
<section class="parent-section shell" id="parent-mode" aria-labelledby="parent-title">
 <div class="parent-intro">
  <div><p class="parent-eyebrow" data-i18n="parenteyebrow">PARENT MODE · CREATE TOGETHER</p><h2 id="parent-title" data-i18n="parenttitle">Little hands.<br><span>Big imagination.</span></h2></div>
  <div class="parent-story"><p data-i18n="parentintro">A little studio for kids to make Diandian their own. Choose the animations on a computer, see them come to life, then take them to the companion on the desk.</p><a class="prototype-link" href="http://localhost:3002/settings.html?mode=child&amp;entry=parent" target="_blank" rel="noopener"><span data-i18n="openprototype">Explore parent mode</span><i class="ri ri-arrow-right-up-line" aria-hidden="true"></i></a></div>
 </div>
 <div class="creation-stage">
  <div class="studio-window" aria-label="Interactive animation preview">
   <div class="studio-chrome"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>Diandian studio</span><span class="studio-chrome-note" data-i18n="studiodesktop">ON THE COMPUTER</span></div>
   <div class="studio-toolbar"><strong data-i18n="studioheading">A little personality.</strong><span data-i18n="studiohint">Pick a mood to preview</span></div>
   <div class="studio-body">
    <div class="studio-preview"><video id="studio-video" data-video="wave" muted playsinline preload="none" aria-label="Selected animation preview" data-loop-gap="2000"></video><div class="studio-preview-caption"><span class="studio-live-dot" aria-hidden="true"></span><span id="studio-current-name">Waving</span><span class="studio-loop" data-i18n="studioloop">Loop preview</span></div></div>
    <div class="studio-moods" role="group" aria-label="Choose an animation">
     <button class="studio-mood" data-studio-mode="wait" aria-pressed="false"><img data-poster="wait" alt=""><span data-i18n="studiowait">Daydreaming</span></button>
     <button class="studio-mood" data-studio-mode="listen" aria-pressed="false"><img data-poster="listen" alt=""><span data-i18n="studiolisten">Listening</span></button>
     <button class="studio-mood" data-studio-mode="happy" aria-pressed="false"><img data-poster="happy" alt=""><span data-i18n="studiohappy">Happy</span></button>
     <button class="studio-mood" data-studio-mode="wave" aria-pressed="true"><img data-poster="wave" alt=""><span data-i18n="studiowave">Waving</span></button>
     <button class="studio-mood" data-studio-mode="comfort" aria-pressed="false"><img data-poster="comfort" alt=""><span data-i18n="studiocomfort">Comforting</span></button>
     <button class="studio-mood" data-studio-mode="sleep" aria-pressed="false"><img data-poster="sleep" alt=""><span data-i18n="studiosleep">Sleepy</span></button>
    </div>
   </div>
   <div class="studio-footer"><a id="studio-download" class="studio-download" download="diandian-wave.mp4"><i class="ri ri-download-2-line" aria-hidden="true"></i><span data-i18n="downloadpreview">Download preview</span></a><a class="studio-open" href="http://localhost:3002/settings.html?mode=child&amp;entry=parent" target="_blank" rel="noopener"><span data-i18n="openeditor">Open editor</span><i class="ri ri-arrow-right-up-line" aria-hidden="true"></i></a></div>
  </div>
  <div class="hardware-destination">
   <span class="destination-label" data-i18n="onthedesk">ON THE DESK</span>
   <div class="destination-arrow" aria-hidden="true"><i class="ri ri-arrow-right-line"></i></div>
   <div class="hardware-preview"><div class="hardware-bezel"><video id="hardware-video" data-video="wave" muted playsinline preload="none" aria-label="Hardware animation preview" data-loop-gap="2000"></video></div></div>
   <p class="destination-title" data-i18n="theirown">Their very own<br>little companion.</p>
   <span class="destination-note" data-i18n="hardwarepreview">Hardware preview</span>
  </div>
 </div>
 <ol class="creation-steps">
  <li><span class="step-number">01</span><div><h3 data-i18n="createone">Make it theirs.</h3><p data-i18n="createonedesc">Choose the expressions and movements.</p></div></li>
  <li><span class="step-number">02</span><div><h3 data-i18n="createtwo">See it move.</h3><p data-i18n="createtwodesc">Try each animation on the computer.</p></div></li>
  <li><span class="step-number">03</span><div><h3 data-i18n="createthree">Send it home.</h3><p data-i18n="createthreedesc">One export, from the screen to the hardware.</p></div></li>
 </ol>
 <p class="prototype-note" data-i18n="prototypephase">The current prototype sends animations to a phone. The hardware handoff is shown here as a concept preview.</p>
</section><div class="page-bottom"></div>
</main>
<dialog id="about-dialog"><button class="dialog-close" aria-label="Close"><i class="ri ri-close-line" aria-hidden="true"></i></button><span class="dialog-eyebrow">A LITTLE FRIEND, A BIG IMAGINATION</span><h2>Meet Diandian.</h2><p>An AI dolphin made for a five-year-old. A little friend to listen, tell stories, share a meal, and learn a few words of French.</p><p>Explore the character, turn the physical knob, and try the animation studio in parent mode.</p></dialog>
<dialog id="contact-dialog"><button class="dialog-close" aria-label="Close"><i class="ri ri-close-line" aria-hidden="true"></i></button><span class="dialog-eyebrow">SAY HELLO</span><h2>Let’s talk.</h2><p>Have a project in mind, or want to hear more about Diandian?</p><a class="email-link" href="mailto:lu.jin.ixd@gmail.com">lu.jin.ixd@gmail.com <i class="ri ri-arrow-right-line" aria-hidden="true"></i></a></dialog>
<div class="toast" role="status" aria-live="polite"></div>
<script id="embedded-media" type="application/json">{"nod":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"wait":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"wave":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"eat":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"listen":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"curious":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"excited":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"happy":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"comfort":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"talk":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"},"sleep":{"video":"data:video/mp4;base64,","poster":"data:image/jpeg;base64,"}}</script>
<script>
(()=>{'use strict';
const media=JSON.parse(document.getElementById('embedded-media').textContent);
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
const modes=[{name:'Wait',asset:'wait',status:'Daydreaming',color:'#50d4d1',phrase:'I’m right here. What shall we do today?'},{name:'Listen',asset:'listen',status:'Listening',color:'#6acdf6',phrase:'I’m listening. Tell me about your day.'},{name:'Talk',asset:'talk',status:'Talking',color:'#b696ff',phrase:'Hello! I’m Diandian, your little dolphin friend.'},{name:'Eat',asset:'eat',status:'Eating',color:'#85dfaa',phrase:'Let’s have a little bite together. Yum!'},{name:'Bonjour',asset:'wave',status:'Bonjour!',color:'#ffb65e',phrase:'Bonjour, mon ami! Comment ça va?'},{name:'Goodnight',asset:'sleep',status:'Sleepy',color:'#ff8199',phrase:'Time for sweet dreams. Goodnight, my little friend.'}];
const moodNames={wait:'Daydreaming',listen:'Listening',talk:'Talking',eat:'Eating',sleep:'Sleepy',wave:'Waving',nod:'Nodding',happy:'Happy',comfort:'Comforting',excited:'Excited',curious:'Curious'};
const hero=$('#hero-knob');let voiceEnabled=false,toastTimer,language='en',selectedRingColor=null;
const gapTimers=new WeakMap();
function stopGap(video){const timer=gapTimers.get(video);if(timer){clearTimeout(timer);gapTimers.delete(video)}}
function startGap(video){stopGap(video);const gap=parseInt(video.dataset.loopGap,10);if(!(gap>=0))return;const timer=setTimeout(()=>{gapTimers.delete(video);if(video.dataset.near!=='1'||document.hidden||reduced.matches)return;video.currentTime=0;const pending=video.play();if(pending)pending.catch(()=>{})},gap);gapTimers.set(video,timer)}
function ensureVideo(video,key){if(video.dataset.current===key)return;stopGap(video);video.dataset.current=key;video.poster=media[key].poster;video.src=media[key].video;video.load()}
function setVideo(video,key,play=true){ensureVideo(video,key);if(play&&!reduced.matches&&!document.hidden){stopGap(video);if(video.ended)video.currentTime=0;const pending=video.play();if(pending)pending.catch(()=>{})}else video.pause()}
function updatePlayback(video){if(reduced.matches){stopGap(video);video.pause();try{video.currentTime=0}catch(e){}return}if(video.dataset.near!=='1'||document.hidden){stopGap(video);video.pause();return}if(gapTimers.has(video))return;if(video.ended&&parseInt(video.dataset.loopGap,10)>=0)startGap(video);else{const pending=video.play();if(pending)pending.catch(()=>{})}}
// Continue both ends so a full-card move stays filled at the clipped edges.
const gallery=$('#gallery'),galleryBoard=$('.gallery-board'),galleryColumns=$$('.gallery-column');
galleryColumns.forEach(column=>{
 const tiles=[...column.children].filter(tile=>tile.querySelector('.tile-circle'));
 for(const [side,items] of [['before',tiles.slice(-2)],['after',tiles.slice(0,1)]]){
  const continuation=document.createElement('div');
  continuation.className=`gallery-continuation gallery-${side}`;
  continuation.setAttribute('aria-hidden','true');
  continuation.setAttribute('inert','');
  items.forEach(tile=>{
   const copy=tile.cloneNode(true);
   copy.removeAttribute('data-gallery-mood');
   copy.tabIndex=-1;
   continuation.append(copy);
  });
  column.append(continuation);
 }
});
const videos=$$('video[data-video]');videos.forEach(v=>{v.poster=media[v.dataset.video].poster;v.loop=false;v.removeAttribute('loop');v.removeAttribute('autoplay');if(!v.dataset.loopGap)v.dataset.loopGap='2000';v.addEventListener('ended',()=>{if(v.dataset.near==='1'&&!document.hidden&&!reduced.matches)startGap(v)})});$$('[data-poster]').forEach(i=>i.src=media[i.dataset.poster].poster);
const observer=new IntersectionObserver(entries=>entries.forEach(({target,isIntersecting})=>{target.dataset.near=isIntersecting?'1':'';if(isIntersecting)ensureVideo(target,target.dataset.current||target.dataset.video);updatePlayback(target)}),{rootMargin:'200px 0px'});videos.forEach(v=>observer.observe(v));
const heroVideo=hero.querySelector('video');if(heroVideo&&!reduced.matches&&!document.hidden){heroVideo.dataset.near='1';ensureVideo(heroVideo,heroVideo.dataset.current||heroVideo.dataset.video);updatePlayback(heroVideo)}
reduced.addEventListener('change',()=>videos.forEach(v=>{if(reduced.matches){stopGap(v);v.pause();try{v.currentTime=0}catch(e){}}else updatePlayback(v)}));
function toast(text){$('.toast').textContent=text;$('.toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('.toast').classList.remove('show'),2500)}
function speak(index){if(!voiceEnabled||!('speechSynthesis' in window))return;speechSynthesis.cancel();const utterance=new SpeechSynthesisUtterance(modes[index].phrase);utterance.lang=index===4?'fr-FR':'en-US';utterance.rate=.92;utterance.pitch=1.3;speechSynthesis.speak(utterance)}
function setMode(knob,index,{announce=false}={}){index=(index+6)%6;const mode=modes[index];knob.dataset.index=index;knob.setAttribute('aria-valuenow',index);knob.setAttribute('aria-valuetext',mode.name);knob.style.setProperty('--angle',(index*50-14)+'deg');knob.style.setProperty('--arc',(index+1)*60+'deg');knob.style.setProperty('--ring',knob===hero?(selectedRingColor||mode.color):mode.color);setVideo(knob.querySelector('video'),mode.asset);knob.querySelector('.voice-badge').classList.toggle('visible',index===2);if(knob===hero){$('#hero-status').textContent=mode.status;$('#mode-range').value=index;$('#mode-range').setAttribute('aria-valuetext',mode.name);$('.mood-button img').src=media[mode.asset].poster;$$('.swatch').forEach(b=>b.setAttribute('aria-pressed',b.dataset.color===(selectedRingColor||mode.color)))}if(announce)speak(index)}
hero.dataset.index='1';
function pressKnob(knob){knob.classList.add('is-pressed');setTimeout(()=>knob.classList.remove('is-pressed'),200);const index=Number(knob.dataset.index);if(index===2){const v=knob.querySelector('video');stopGap(v);v.currentTime=0;const pending=v.play();if(pending)pending.catch(()=>{});speak(index)}else setMode(knob,2,{announce:true})}
function bindKnob(knob){let drag=null;const angle=e=>{const r=knob.getBoundingClientRect();return Math.atan2(e.clientY-r.top-r.height/2,e.clientX-r.left-r.width/2)*180/Math.PI};knob.addEventListener('pointerdown',e=>{if(e.button!==0)return;knob.focus({preventScroll:true});knob.setPointerCapture(e.pointerId);drag={x:e.clientX,y:e.clientY,last:angle(e),total:0,start:Number(knob.dataset.index),moved:false};knob.querySelector('.metal-rim').style.transition='none';knob.querySelector('.indicator-track').style.transition='none'});knob.addEventListener('pointermove',e=>{if(!drag)return;if(Math.hypot(e.clientX-drag.x,e.clientY-drag.y)>6)drag.moved=true;if(!drag.moved)return;const next=angle(e);let delta=next-drag.last;if(delta>180)delta-=360;if(delta< -180)delta+=360;drag.total+=delta;drag.last=next;const index=((drag.start+Math.round(drag.total/50))%6+6)%6;if(index!==Number(knob.dataset.index))setMode(knob,index);knob.style.setProperty('--angle',(drag.start*50-14+drag.total)+'deg')});const finish=(e,cancel=false)=>{if(!drag)return;const click=!drag.moved;drag=null;knob.querySelector('.metal-rim').style.transition='';knob.querySelector('.indicator-track').style.transition='';knob.style.setProperty('--angle',(Number(knob.dataset.index)*50-14)+'deg');if(click&&!cancel)pressKnob(knob)};knob.addEventListener('pointerup',e=>finish(e));knob.addEventListener('pointercancel',e=>finish(e,true));knob.addEventListener('keydown',e=>{if(['ArrowRight','ArrowUp','ArrowLeft','ArrowDown','Home','End'].includes(e.key)){e.preventDefault();const old=Number(knob.dataset.index);setMode(knob,e.key==='Home'?0:e.key==='End'?5:old+(['ArrowRight','ArrowUp'].includes(e.key)?1:-1))}else if(e.key==='Enter'||e.key===' '){e.preventDefault();pressKnob(knob)}})}
bindKnob(hero);$('#mode-range').addEventListener('input',e=>setMode(hero,+e.target.value));
$$('.swatch').forEach(b=>b.addEventListener('click',()=>{selectedRingColor=b.dataset.color;hero.style.setProperty('--ring',selectedRingColor);$$('.swatch').forEach(x=>x.setAttribute('aria-pressed',x===b))}));
function mood(key){setVideo(hero.querySelector('video'),key);$('#hero-status').textContent=moodNames[key];$('.mood-button img').src=media[key].poster;hero.querySelector('.voice-badge').classList.toggle('visible',key==='talk');const idx=modes.findIndex(m=>m.asset===key);if(idx>=0){hero.dataset.index=idx;hero.setAttribute('aria-valuenow',idx);$('#mode-range').value=idx;$('#mode-range').setAttribute('aria-valuetext',modes[idx].name);hero.setAttribute('aria-valuetext',modes[idx].name)}else hero.setAttribute('aria-valuetext',moodNames[key]);$('#mood-menu').hidden=true;$('.mood-button').setAttribute('aria-expanded','false')}
$('.mood-button').addEventListener('click',()=>{const open=$('#mood-menu').hidden;$('#mood-menu').hidden=!open;$('.mood-button').setAttribute('aria-expanded',open)});$$('[data-mood]').forEach(b=>b.addEventListener('click',()=>mood(b.dataset.mood)));$('#shuffle').addEventListener('click',()=>{const keys=Object.keys(moodNames).filter(k=>k!==hero.querySelector('video').dataset.current);mood(keys[Math.floor(Math.random()*keys.length)]);hero.style.setProperty('--angle',Math.round(Math.random()*300)+'deg')});$('#reset').addEventListener('click',()=>{selectedRingColor=null;setMode(hero,1);if('speechSynthesis'in window)speechSynthesis.cancel()});
$('#voice-toggle').addEventListener('click',()=>{if(!('speechSynthesis'in window)){toast('Voice preview isn’t supported in this browser.');return}voiceEnabled=!voiceEnabled;$('#voice-toggle').setAttribute('aria-pressed',voiceEnabled);$('#voice-toggle').setAttribute('aria-label',voiceEnabled?'Disable demo voice':'Enable demo voice');$('#voice-toggle').title=voiceEnabled?'Disable demo voice':'Enable demo voice';if(voiceEnabled){toast('Demo voice on');speak(Number(hero.dataset.index))}else{speechSynthesis.cancel();toast('Demo voice off')}});
$$('[data-gallery-mood]').forEach(b=>b.addEventListener('click',()=>{mood(b.dataset.galleryMood);document.querySelector('.hero-playground').scrollIntoView({behavior:reduced.matches?'instant':'smooth',block:'center'});hero.focus({preventScroll:true})}));
// Resolve the hovered lane against the stationary board, not the moving tiles.
const finePointer=matchMedia('(hover: hover) and (pointer: fine)');
const columnOrigins=galleryColumns.map(column=>new DOMMatrixReadOnly(getComputedStyle(column).transform).m42);
let galleryFrame=0,galleryPointer=null,activeGalleryColumn=-1,galleryDirection=0;
function restoreGalleryColumn(index){if(index>=0)galleryColumns[index].style.transform=''}
function resetGalleryMotion(){
 cancelAnimationFrame(galleryFrame);galleryFrame=0;galleryPointer=null;
 restoreGalleryColumn(activeGalleryColumn);activeGalleryColumn=-1;galleryDirection=0;
}
function moveGalleryColumn(){
 galleryFrame=0;
 if(!galleryPointer||reduced.matches||!finePointer.matches)return resetGalleryMotion();
 const {x,y}=galleryPointer,rect=gallery.getBoundingClientRect(),boardRect=galleryBoard.getBoundingClientRect();
 const matrix=new DOMMatrixReadOnly(getComputedStyle(galleryBoard).transform);
 const boardWidth=galleryBoard.offsetWidth,gap=parseFloat(getComputedStyle(galleryBoard).columnGap);
 const columnWidth=(boardWidth-gap*(galleryColumns.length-1))/galleryColumns.length;
 const dx=x-(boardRect.left+boardRect.width/2),dy=y-(boardRect.top+boardRect.height/2);
 const localX=(matrix.d*dx-matrix.c*dy)/(matrix.a*matrix.d-matrix.b*matrix.c)+boardWidth/2;
 const next=Math.floor((localX+gap/2)/(columnWidth+gap));
 const visibleTop=Math.max(rect.top,$('.site-header').getBoundingClientRect().bottom),visibleBottom=Math.min(rect.bottom,innerHeight);
 if(x<rect.left||x>rect.right||y<visibleTop||y>visibleBottom||next<0||next>=galleryColumns.length)return resetGalleryMotion();
 const position=Math.max(-1,Math.min(1,(y-(visibleTop+visibleBottom)/2)/((visibleBottom-visibleTop)/2)));
 // Reveal a whole neighboring card, including its gutter, even near the center.
 // Keep the direction through a small center band to avoid flipping back and forth.
 if(next!==activeGalleryColumn||!galleryDirection)galleryDirection=position<=0?1:-1;
 else if(position<-.18)galleryDirection=1;
 else if(position>.18)galleryDirection=-1;
 const tile=galleryColumns[next].querySelector('.tile:not(.word-tile):not(.phone-tile)');
 const travel=tile.offsetHeight+gap;
 const offset=galleryDirection*travel;
 if(next!==activeGalleryColumn){restoreGalleryColumn(activeGalleryColumn);activeGalleryColumn=next}
 galleryColumns[next].style.transform=`translateY(${(columnOrigins[next]+offset).toFixed(2)}px)`;
}
function queueGalleryMotion(){if(galleryPointer&&!galleryFrame)galleryFrame=requestAnimationFrame(moveGalleryColumn)}
gallery.addEventListener('pointermove',event=>{
 if(event.pointerType==='touch'||reduced.matches||!finePointer.matches)return;
 galleryPointer={x:event.clientX,y:event.clientY};queueGalleryMotion();
},{passive:true});
gallery.addEventListener('pointerleave',resetGalleryMotion);
gallery.addEventListener('pointercancel',resetGalleryMotion);
gallery.addEventListener('click',resetGalleryMotion);
window.addEventListener('scroll',queueGalleryMotion,{passive:true});
window.addEventListener('resize',resetGalleryMotion,{passive:true});
window.addEventListener('blur',resetGalleryMotion);
reduced.addEventListener('change',resetGalleryMotion);
finePointer.addEventListener('change',resetGalleryMotion);
document.addEventListener('visibilitychange',()=>{if(document.hidden)resetGalleryMotion()});
let studioMode='wave';
function chooseStudioMode(key){
 studioMode=key;
 setVideo($('#studio-video'),key);
 setVideo($('#hardware-video'),key);
 $$('.studio-mood').forEach(button=>button.setAttribute('aria-pressed',button.dataset.studioMode===key));
 $('#studio-current-name').textContent=$(`.studio-mood[data-studio-mode="${key}"] span`).textContent;
 $('#studio-download').href=media[key].video;
 $('#studio-download').download=`diandian-${key}.mp4`;
}
$$('.studio-mood').forEach(button=>button.addEventListener('click',()=>chooseStudioMode(button.dataset.studioMode)));
$('#studio-download').href=media.wave.video;
function closeMenus(){$$('.dropdown-menu').forEach(m=>m.hidden=true);$$('.dropdown>.nav-button').forEach(b=>b.setAttribute('aria-expanded','false'))}
$$('.dropdown>.nav-button').forEach(b=>b.addEventListener('click',()=>{const menu=document.getElementById(b.getAttribute('aria-controls')),open=menu.hidden;closeMenus();menu.hidden=!open;b.setAttribute('aria-expanded',open)}));document.addEventListener('click',e=>{if(!e.target.closest('.dropdown'))closeMenus();if(!e.target.closest('.mood-button,.mood-menu')){$('#mood-menu').hidden=true;$('.mood-button').setAttribute('aria-expanded','false')}});$$('.dropdown-menu a').forEach(a=>a.addEventListener('click',closeMenus));document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenus();$('#mood-menu').hidden=true;$('.mood-button').setAttribute('aria-expanded','false');$('#nav-links').classList.remove('mobile-open');$('.mobile-menu').setAttribute('aria-expanded','false')}});
$('.mobile-menu').addEventListener('click',()=>{const open=$('#nav-links').classList.toggle('mobile-open');$('.mobile-menu').setAttribute('aria-expanded',open)});
$$('[data-dialog]').forEach(b=>b.addEventListener('click',()=>document.getElementById(b.dataset.dialog).showModal()));$$('dialog').forEach(d=>{d.querySelector('.dialog-close').addEventListener('click',()=>d.close());d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}})});
const translations={"parentmode":"家长模式","animationstudio":"动画工作台","parenteyebrow":"家长模式 · 一起创造","parenttitle":"小小双手。<br><span>大大想象。</span>","parentintro":"一个让孩子亲手创造点点的小工作台。在电脑上选择动画，看它动起来，再把它带到桌上的小伙伴里。","openprototype":"体验家长模式","studiodesktop":"在电脑上","studioheading":"让点点有自己的性格。","studiohint":"选择一个动作，看看它的样子","studioloop":"循环预览","studiowait":"发呆","studiolisten":"倾听","studiohappy":"开心","studiowave":"招手","studiocomfort":"安慰","studiosleep":"困了","downloadpreview":"下载预览动画","openeditor":"打开编辑器","onthedesk":"来到桌上","theirown":"自己创造的<br>小伙伴。","hardwarepreview":"硬件效果预览","createone":"选出自己的点点。","createonedesc":"选择它的表情和动作。","createtwo":"看看它怎么动。","createtwodesc":"在电脑上逐个预览动画。","createthree":"把它带到桌上。","createthreedesc":"一键导出，从电脑来到硬件里。","prototypephase":"当前原型支持发送到手机；这里的硬件传输流程为概念预览。",ringcolor:'灯环颜色',projects:'项目',hardware:'旋钮硬件',playground:'游乐场',allmoods:'每一种小心情',tryknob:'试试旋钮',about:'关于',contact:'联系我',intro:'<strong>点点</strong>是一个 AI 海豚朋友。我五岁的孩子可以用手机给它打电话，也可以转动桌上的旋钮，把它唤醒。Gemini 不向 18 岁以下的孩子提供语音，所以通话改走火山引擎。发音在硬件上没那么干净，这条路也得再绕一层。',turntitle:'转一转，聊聊天。',hint:'转动选择 · 按下说话',closing:'手机是大人的物件，所以点点也住进了旋钮里的圆形屏幕。不用菜单，不用阅读——灯环告诉你当前的状态，小海豚告诉你它在做什么。'};const originals=new Map();$$('[data-i18n]').forEach(el=>originals.set(el,el.innerHTML));$$('[data-language]').forEach(b=>b.addEventListener('click',()=>{language=b.dataset.language;document.documentElement.lang=language;$('#language-name').textContent=language==='zh'?'中文':'English';originals.forEach((text,el)=>el.innerHTML=language==='zh'?(translations[el.dataset.i18n]||text):text);$('#studio-current-name').textContent=$(`.studio-mood[data-studio-mode="${studioMode}"] span`).textContent;closeMenus()}));
document.addEventListener('visibilitychange',()=>{if(document.hidden){videos.forEach(v=>{stopGap(v);v.pause()});if('speechSynthesis'in window)speechSynthesis.cancel()}else videos.forEach(updatePlayback)});
})();
</script>
</body>
</html>
