{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./ca/client-advisor/*"],
      "@eon/*": ["./eon/e-on-09/*"],
      "@header/*": ["./global-header/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "ca/client-advisor/**/*.ts",
    "ca/client-advisor/**/*.tsx",
    "eon/e-on-09/**/*.ts",
    "eon/e-on-09/**/*.tsx",
    "global-header/**/*.ts",
    "global-header/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/.next"
  ]
}
