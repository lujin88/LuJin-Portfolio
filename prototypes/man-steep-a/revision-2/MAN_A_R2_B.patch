+/* MAN A integration. All styles scoped to the new section; case.css stays unchanged. */
+.man-case .man-motion {background:#f9f1e5;position:relative;}
+.man-case .man-motion-stage {position:relative;max-width:1184px;margin-inline:auto;padding:70px 0 80px;}
+.man-case .man-motion-over {font-size:13px;color:var(--muted);margin:0 0 25px;}
+.man-case .man-motion-slogan {font-family:var(--serif);font-weight:400;font-size:clamp(38px,4.7vw,68px);letter-spacing:-.045em;line-height:1.04;margin:0 0 34px;max-width:850px;}
+.man-case .man-motion-final {font-family:var(--serif);font-weight:400;font-size:clamp(34px,3.8vw,54px);line-height:1.06;letter-spacing:-.04em;margin:0 0 28px;}
+.man-case .man-motion-assembly {border:1px solid #e8ddd1;background:#fffefa;border-radius:14px;padding:18px;}
+.man-case .man-motion-board-heading {display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--rule);padding-bottom:16px;font-size:16px;}
+.man-case .man-motion-board-heading small {color:var(--muted);font-size:12px;}
+.man-case .man-motion-cards {display:flex;gap:12px;margin-top:16px;}
+.man-case .man-motion-card {flex:none;background:#fffefa;border:1px solid #e8ddd1;border-radius:10px;padding:14px 10px 10px;transform-origin:0 0;}
+.man-case .man-motion-card-label {display:block;color:var(--muted);font-size:12px;margin:0 0 8px 3px;white-space:nowrap;}
+.man-case .man-motion-crop {overflow:hidden;position:relative;}
+.man-case .man-motion-crop img {position:absolute;max-width:none;width:1440px;height:960px;top:-461px;}
+.man-case .man-motion-note {color:var(--muted);font-size:12px;line-height:1.4;margin:20px 0 0;}
+/* Static assembled layout is the baseline: works without JavaScript and with reduced motion. */
+@media(min-width:1001px) {
+  /* Keep the scene coordinates; the note and 96px padding define its lower edge.
+     A normal-flow spacer supplies the independent, reversible scroll distance. */
+  .man-case .man-motion.is-scrubbed::after {content:"";display:block;height:min(80vh,900px);}
+  .man-case .is-scrubbed .man-motion-stage {position:sticky;top:0;padding:calc(clamp(258.4px,38vh,380px) + 257px) 0 96px;overflow:visible;}
+  .man-case .is-scrubbed .man-motion-over {position:absolute;top:clamp(54.4px,8vh,80px);left:0;margin:0;}
+  .man-case .is-scrubbed .man-motion-slogan {position:absolute;top:clamp(210.8px,31vh,310px);left:0;max-width:850px;margin:0;opacity:0;}
+  .man-case .is-scrubbed .man-motion-final {position:absolute;top:clamp(156.4px,23vh,230px);left:0;margin:0;opacity:0;}
+  .man-case .is-scrubbed .man-motion-board {position:absolute;top:clamp(258.4px,38vh,380px);left:0;width:100%;height:236px;opacity:0;}
+  .man-case .is-scrubbed .man-motion-assembly {display:contents;}
+  .man-case .is-scrubbed .man-motion-board {border:1px solid #e8ddd1;background:#fffefa;border-radius:14px;padding:18px;}
+  .man-case .is-scrubbed .man-motion-cards {display:contents;}
+  .man-case .is-scrubbed .man-motion-card {position:absolute;left:0;top:0;margin:0;}
+  .man-case .is-scrubbed .man-motion-note {position:relative;margin:0;opacity:0;}
+}
+@media(max-width:1280px) {
+  .man-case .man-motion-stage {max-width:calc(100% - 96px);}
+  .man-case .man-motion-cards {flex-wrap:wrap;}
+}
+@media(max-width:1000px) {
+  .man-case .man-motion-stage {max-width:calc(100% - 48px);padding-block:46px;}
+  .man-case .man-motion-slogan {max-width:650px;}
+  .man-case .man-motion-cards {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));}
+  .man-case .man-motion-card {max-width:100%;overflow:hidden;}
+  .man-case .man-motion-final {font-size:32px;}
+}
+@media(max-width:580px) {
+  .man-case .man-motion-stage {max-width:calc(100% - 40px);}
+  .man-case .man-motion-slogan {font-size:39px;}
+  .man-case .man-motion-cards {grid-template-columns:1fr;gap:10px;}
+  .man-case .man-motion-assembly {padding:12px;}
+  .man-case .man-motion-board-heading {font-size:14px;gap:8px;align-items:baseline;}
+  .man-case .man-motion-board-heading small {font-size:10px;}
+  .man-case .man-motion-card {padding-inline:8px;}
+  .man-case .man-motion-crop {max-width:100%;}
+}
+@media(prefers-reduced-motion:reduce) {
+  .man-case .man-motion * {animation:none!important;transition:none!important;}
+}
