# PostHog analytics (EU Cloud). Copy to .env.local and fill in.
# Leave the key empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
# memory (default) | sessionStorage | localStorage+cookie
NEXT_PUBLIC_POSTHOG_PERSISTENCE=memory

# Optional override for large media hosted on Vercel Blob.
# Leave empty to use the store URL committed in lib/external-media.json.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Server-only. Created when the Blob store is connected to this Vercel project.
# Required by `npm run upload-media`. Never commit the value.
# BLOB_READ_WRITE_TOKEN=
