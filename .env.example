# Which model provider: "anthropic" (default), "openai" or "google" (Gemini)
ASK_LU_PROVIDER=anthropic

# Fill the key for the provider you use
ANTHROPIC_API_KEY=        # console.anthropic.com
OPENAI_API_KEY=           # platform.openai.com
GOOGLE_GENERATIVE_AI_API_KEY=   # aistudio.google.com → Get API key

# Model. Defaults to claude-haiku-5-5 for Anthropic.
# Required for OpenAI / Gemini: pick a current model name from the provider's model list
# ASK_LU_MODEL=

# Required in production — Vercel → Storage → Upstash Redis (free tier is enough)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
